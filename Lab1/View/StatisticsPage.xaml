<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Lab1.Views.StatisticsPage"
    Title="Статистика">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Статистика витрат"
                FontSize="28"
                FontAttributes="Bold" />

            <Frame
                Padding="15"
                CornerRadius="12">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="Загальна сума"
                        FontSize="14" />

                    <Label
                        Text="{Binding TotalAmount, StringFormat='{0:F2} UAH'}"
                        FontSize="26"
                        FontAttributes="Bold" />

                </VerticalStackLayout>

            </Frame>

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="10">

                <Frame
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15"
                    CornerRadius="12">

                    <VerticalStackLayout>

                        <Label
                            Text="Кількість витрат"
                            FontSize="13" />

                        <Label
                            Text="{Binding ExpenseCount}"
                            FontSize="24"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Frame>

                <Frame
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="15"
                    CornerRadius="12">

                    <VerticalStackLayout>

                        <Label
                            Text="Середня витрата"
                            FontSize="13" />

                        <Label
                            Text="{Binding AverageAmount, StringFormat='{0:F2} UAH'}"
                            FontSize="20"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Frame>

                <Frame
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="15"
                    CornerRadius="12">

                    <VerticalStackLayout>

                        <Label
                            Text="Найбільша витрата"
                            FontSize="13" />

                        <Label
                            Text="{Binding LargestExpense, StringFormat='{0:F2} UAH'}"
                            FontSize="20"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Frame>

                <Frame
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="15"
                    CornerRadius="12">

                    <VerticalStackLayout>

                        <Label
                            Text="Найбільша категорія"
                            FontSize="13" />

                        <Label
                            Text="{Binding LargestCategory}"
                            FontSize="18"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Frame>

            </Grid>

            <Label
                Text="Витрати за категоріями"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <CollectionView
                ItemsSource="{Binding CategoryStatistics}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame
                            Padding="12"
                            Margin="0,4"
                            CornerRadius="10">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding Category}"
                                    FontSize="17"
                                    FontAttributes="Bold" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Count, StringFormat='Кількість: {0}'}"
                                    FontSize="13" />

                                <Label
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Text="{Binding AmountText}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Назад"
                Command="{Binding GoBackCommand}"
                Margin="0,10,0,0" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>