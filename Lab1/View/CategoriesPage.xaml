<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Lab1.Views.CategoriesPage"
    Title="Категорії">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Мої категорії"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Створіть категорію для подальшого використання під час додавання витрати."
                FontSize="14" />

            <Entry
                Placeholder="Назва нової категорії"
                Text="{Binding NewCategory}" />

            <Button
                Text="Додати категорію"
                Command="{Binding AddCategoryCommand}" />

            <Label
                Text="Список категорій"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <CollectionView
                ItemsSource="{Binding Categories}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame
                            Padding="12"
                            Margin="0,4"
                            CornerRadius="10">

                            <Grid
                                ColumnDefinitions="*,Auto">

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    FontSize="17"
                                    VerticalOptions="Center" />

                                <Button
                                    Grid.Column="1"
                                    Text="Видалити"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCategoryCommand}"
                                    CommandParameter="{Binding .}" />

                            </Grid>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>